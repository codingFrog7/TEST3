{
  "entities": {
    "ScoutRecord": {
      "title": "ScoutRecord",
      "description": "Leaf pathology diagnosis record from AI crop doctor scan",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the farmer who logged the scan"
        },
        "crop": {
          "type": "string",
          "maxLength": 50,
          "description": "Crop species examined"
        },
        "disease": {
          "type": "string",
          "maxLength": 100,
          "description": "Identified disease or pathogen"
        },
        "scientific": {
          "type": "string",
          "maxLength": 100,
          "description": "Scientific botanical or pathological nomenclature"
        },
        "severity": {
          "type": "number",
          "description": "Severity index from 1 to 5"
        },
        "remedy": {
          "type": "string",
          "maxLength": 500,
          "description": "Primary recommended IPM organic or target remedy"
        },
        "date": {
          "type": "string",
          "maxLength": 50,
          "description": "Human-readable calendar date string"
        },
        "time": {
          "type": "string",
          "maxLength": 50,
          "description": "Human-readable time string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when scout record was created"
        }
      },
      "required": ["userId", "crop", "disease", "severity", "createdAt"]
    },
    "FieldNote": {
      "title": "FieldNote",
      "description": "Farmer field advisory and observation notes",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the farmer who wrote the note"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the author"
        },
        "note": {
          "type": "string",
          "maxLength": 1000,
          "description": "Content of the field observation"
        },
        "cropTag": {
          "type": "string",
          "maxLength": 50,
          "description": "Relevant crop tag or general observation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the note was submitted"
        }
      },
      "required": ["userId", "note", "createdAt"]
    },
    "FarmerProfile": {
      "title": "FarmerProfile",
      "description": "Farmer profile preferences, village location and primary crops",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the farmer"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Farmer display name"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "District / State location"
        },
        "primaryCrop": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary cultivated crop"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last profile update"
        }
      },
      "required": ["userId", "displayName", "updatedAt"]
    }
  },
  "firestore": {
    "/scout_records/{recordId}": {
      "schema": "ScoutRecord",
      "description": "Crop leaf scout diagnostic records"
    },
    "/field_notes/{noteId}": {
      "schema": "FieldNote",
      "description": "Farmer field advisory and farm observation notes"
    },
    "/farmer_profiles/{userId}": {
      "schema": "FarmerProfile",
      "description": "Farmer profile and regional preferences"
    }
  }
}
