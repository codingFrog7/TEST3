rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }

    // Entity Validation Helpers
    function isValidScoutRecord(data) {
      return data.userId == request.auth.uid
        && data.crop is string && data.crop.size() >= 1 && data.crop.size() <= 50
        && data.disease is string && data.disease.size() >= 1 && data.disease.size() <= 100
        && data.severity is number && data.severity >= 1 && data.severity <= 5
        && (!('scientific' in data) || (data.scientific is string && data.scientific.size() <= 100))
        && (!('remedy' in data) || (data.remedy is string && data.remedy.size() <= 500))
        && (!('date' in data) || (data.date is string && data.date.size() <= 50))
        && (!('time' in data) || (data.time is string && data.time.size() <= 50))
        && data.createdAt is timestamp;
    }

    function isValidFieldNote(data) {
      return data.userId == request.auth.uid
        && data.note is string && data.note.size() >= 1 && data.note.size() <= 1000
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100))
        && (!('cropTag' in data) || (data.cropTag is string && data.cropTag.size() <= 50))
        && data.createdAt is timestamp;
    }

    function isValidFarmerProfile(data) {
      return data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('location' in data) || (data.location is string && data.location.size() <= 100))
        && (!('primaryCrop' in data) || (data.primaryCrop is string && data.primaryCrop.size() <= 50))
        && data.updatedAt is timestamp;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read: if isValidId(docId);
    }

    // Crop Doctor Scout Records
    match /scout_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(recordId)
        && isValidScoutRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().userId == request.auth.uid;
      allow update: if isVerified()
        && isValidId(recordId)
        && isValidScoutRecord(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && isValidId(recordId)
        && resource.data.userId == request.auth.uid;
    }

    // Farmer Field Notes & Logbook
    match /field_notes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(noteId)
        && isValidFieldNote(incoming())
        && incoming().createdAt == request.time
        && incoming().userId == request.auth.uid;
      allow update: if isVerified()
        && isValidId(noteId)
        && isValidFieldNote(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && isValidId(noteId)
        && resource.data.userId == request.auth.uid;
    }

    // Farmer Regional Profile & Settings
    match /farmer_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create, update: if isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidFarmerProfile(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isVerified()
        && isValidId(userId)
        && userId == request.auth.uid;
    }
  }
}
